# CareerFit — environment template
# 이 파일은 커밋되는 템플릿이다. 실제 값은 절대 여기에 넣지 말고 `.env` 에 넣는다.
# 로컬에서 사용하려면:  cp .env.example .env

# ─────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────
# true 이면 LLM 호출 없이 결정론 mock 응답을 반환한다.
# ✅ 안전한 기본값 (Grill Me #1 Finding 5): 실수로 실제 자료를 LLM 에 보내지 않도록
#    최초 실행은 항상 Mock 이다. Live 를 원하면 명시적으로 false 로 바꾼다.
MOCK_MODE=true

# 사용할 LLM 프로바이더. 값: gemini | openai
# gemini 는 Google AI Studio (aistudio.google.com) 에서 무료 API 키 발급 가능.
# openai 는 platform.openai.com 유료 계정 필요.
LLM_PROVIDER=gemini

# ─────────────────────────────────────────────────────────
# ⚠ Data flow disclosure (반드시 읽어주세요)
# ─────────────────────────────────────────────────────────
# LIVE 모드에서는 업로드한 이력서/경력기술서/포트폴리오/공고 원문이
# 선택한 프로바이더의 서버로 전송됩니다.
#
# - Google Gemini (AI Studio 무료 티어): 제출한 프롬프트가 모델 개선에 활용될 수 있습니다.
#   최신 정책은 https://ai.google.dev/gemini-api/terms 에서 확인하세요.
# - OpenAI API: 기본적으로 학습 데이터로 사용되지 않으나, 계정 설정에 따라 다를 수 있습니다.
#   https://openai.com/policies/api-data-usage-policies 참고.
#
# 실제 개인 이력서로 시연하기 전에 위 정책을 확인해 주세요.
# ─────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────
# Google Gemini (기본 · 무료 티어)
# ─────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ─────────────────────────────────────────────────────────
# OpenAI (선택 · 유료)
# ─────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────
# Upload / URL / CORS
# ─────────────────────────────────────────────────────────
# 업로드 최대 크기 (bytes). 기본 20MB.
MAX_UPLOAD_BYTES=20971520

# URL extractor 가 다운로드할 수 있는 최대 body 크기 (bytes). 기본 2MB.
MAX_URL_BYTES=2097152

# 프론트엔드 개발 서버 origin 리스트 (콤마 구분). Vite fallback 포트까지 포함.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ─────────────────────────────────────────────────────────
# Scoring weights (선택 · 총합은 반드시 1.0)
# ─────────────────────────────────────────────────────────
# 지정하지 않으면 코드 기본값 사용: 0.30 / 0.35 / 0.20 / 0.10 / 0.05
# WEIGHT_RESPONSIBILITY=0.30
# WEIGHT_REQUIREMENT=0.35
# WEIGHT_TECH=0.20
# WEIGHT_EXPERIENCE=0.10
# WEIGHT_PREFERRED=0.05
